# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets to the repo.

# Proxmox API token (used for status polling and LXC actions)
PVE_API_TOKEN=PVEAPIToken=root@pam!<token-id>=<uuid>

# Proxmox username + password (used only for console auto-login / panes view)
PVE_USERNAME=root@pam
PVE_PASSWORD=

# Optional — desktop PC rail beside the GPU graph (online dot, wake/restart/shutdown).
# Needs wakeonlan installed and the service user's SSH key on the PC. Omit to hide the rail.
PC_IP=
PC_USER=
PC_MAC=
